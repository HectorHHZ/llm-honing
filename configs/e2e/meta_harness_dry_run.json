{
  "description": "Meta-Harness end to end with no GPU, model, or Claude Code: all_planes.json with the harness method replaced by Meta-Harness and its proposer by a script that follows the skill's workflow (tests.fakes.pipeline:proposer). Meta-Harness searches on harness_tasks, training twins of the gate's tasks, and the gate judges on the held-out tasks. Step 1 adds a verify line, which wins on both and is published; step 2 trains new weights; step 3 rescores the served harness under them (Phase 0) and adds a line that ties on the search tasks, so nothing is proposed; step 4 rolls back to the release before step 3.",
  "work_dir": "runs/e2e-meta-harness",
  "requires": {
    "env": [],
    "commands": [],
    "paths": []
  },
  "tasks": {
    "factory": "tests.fakes.pipeline:tasks"
  },
  "harness_tasks": {
    "factory": "tests.fakes.pipeline:search_tasks"
  },
  "harness_seed": {
    "factory": "tests.fakes.pipeline:harness_seed"
  },
  "harness": {
    "episode_budget": 7
  },
  "components": {
    "model_source": {
      "factory": "tests.fakes.pipeline:model_source"
    },
    "endpoints": {
      "factory": "tests.fakes.pipeline:endpoints"
    },
    "trainer": {
      "factory": "tests.fakes.pipeline:trainer",
      "args": {
        "gain": 0.1
      }
    },
    "data": {
      "factory": "tests.fakes.pipeline:data"
    },
    "rollout": {
      "factory": "tests.fakes.pipeline:rollout"
    },
    "scorer": {
      "factory": "tests.fakes.pipeline:scorer"
    },
    "selector": {
      "factory": "tests.fakes.pipeline:selector"
    },
    "editor": {
      "factory": "tests.fakes.pipeline:editor"
    },
    "quantizer": {
      "factory": "tests.fakes.pipeline:quantizer"
    },
    "telemetry": {
      "factory": "tests.fakes.pipeline:telemetry"
    },
    "runner": {
      "factory": "tests.fakes.pipeline:runner"
    },
    "grader": {
      "factory": "tests.fakes.pipeline:grader"
    },
    "method": {
      "factory": "honing.e2e.meta_harness:method",
      "args": {
        "proposer": {
          "factory": "tests.fakes.pipeline:proposer"
        }
      }
    }
  },
  "selectors": {
    "default": {
      "win_loss": {}
    },
    "prune": {
      "no_regression": {
        "max_regression": 0.05
      }
    },
    "quantize": {
      "no_regression": {
        "max_regression": 0.01
      }
    }
  },
  "defaults": {
    "train": {
      "algorithm": "sft",
      "steps": 10
    },
    "budget": {
      "keep_ratio": 0.75
    },
    "recovery": {
      "algorithm": "distill",
      "steps": 10,
      "teacher": {
        "kind": "lineage",
        "ref": "parent",
        "placement": "engine"
      }
    },
    "scheme": {
      "weight_format": "int4",
      "granularity": "group",
      "group_size": 128
    }
  },
  "schedule": [
    {
      "kind": "harness",
      "label": "verify"
    },
    {
      "kind": "train",
      "algorithm": "sft",
      "steps": 10
    },
    {
      "kind": "harness",
      "label": "tie"
    },
    {
      "kind": "rollback",
      "to": "r0001"
    }
  ],
  "expect": [
    "published",
    "published",
    "skipped",
    "restored"
  ]
}
