{
  "description": "GEPA end to end against real model APIs, with no GPU (#100): a minimal agent calls a hosted OpenAI-compatible policy, a command grader scores its edits, and GEPA reflects through litellm. The model, data, training and compression planes are the walking skeleton's fakes; a harness move never touches them. Harness moves until the first publish (at most 12; a move that does not reach the gate charges at most 6 of the 100 metric calls, so after 11 such moves the 12th can still reach it), one more so the pending state moves past it, a rollback to that first publish, then 29 more. Every move charges at least the parent's minibatch (3 metric calls) and the first publish holds at least 16, so 28 moves after the rollback reach max_metric_calls whatever the models reply; the 29th shows the stop.",
  "work_dir": "runs/e2e-gepa-live",
  "requires": {
    "env": ["OPENAI_API_KEY"],
    "commands": ["python3"],
    "paths": []
  },
  "model": {"provider": "openai", "name": "gpt-4.1-mini-2025-04-14"},
  "tasks": {
    "factory": "honing.e2e.gepa_live:suite_tasks",
    "args": {"manifest": "examples/tasks/python-bugfix/gepa-live.jsonl", "split": "val"}
  },
  "harness_tasks": {
    "factory": "honing.e2e.gepa_live:suite_tasks",
    "args": {"manifest": "examples/tasks/python-bugfix/gepa-live.jsonl", "split": "train"}
  },
  "harness": {
    "episode_budget": 6
  },
  "harness_seed": {
    "factory": "honing.e2e.gepa_live:harness_seed",
    "args": {
      "directory": "examples/harnesses/gepa-live-seed",
      "files": {"AGENTS.md": "instructions", "skills/debugging.md": "skill"}
    }
  },
  "components": {
    "model_source": {"factory": "tests.fakes.pipeline:model_source"},
    "endpoints": {
      "factory": "honing.e2e.gepa_live:openai_endpoints",
      "args": {"base_url": "https://api.openai.com/v1", "model": {"ref": "model"}}
    },
    "trainer": {"factory": "tests.fakes.pipeline:trainer"},
    "data": {"factory": "tests.fakes.pipeline:data"},
    "scorer": {"factory": "tests.fakes.pipeline:scorer"},
    "selector": {"factory": "tests.fakes.pipeline:selector"},
    "editor": {"factory": "tests.fakes.pipeline:editor"},
    "quantizer": {"factory": "tests.fakes.pipeline:quantizer"},
    "telemetry": {"factory": "tests.fakes.pipeline:telemetry"},
    "runner": {
      "factory": "honing.e2e.gepa_live:manifest_runner",
      "args": {
        "command": ["{python}", "{root}/scripts/e2e/minimal_agent.py"],
        "manifest": "examples/tasks/python-bugfix/gepa-live.jsonl",
        "api_key_env": "OPENAI_API_KEY",
        "agents": ["minimal"],
        "file_kinds": ["instructions", "skill"],
        "concurrency": 4,
        "timeout_seconds": 180,
        "agent_timeout_seconds": 60,
        "agent_max_attempts": 3,
        "agent_max_tokens": 2048
      }
    },
    "grader": {
      "factory": "honing.e2e.gepa_live:command_grader",
      "args": {"manifest": "examples/tasks/python-bugfix/gepa-live.jsonl", "timeout_seconds": 120}
    },
    "method": {
      "factory": "honing.e2e.gepa_live:gepa_method",
      "args": {
        "manifest": "examples/tasks/python-bugfix/gepa-live.jsonl",
        "reflection": {
          "model": {"ref": "model"},
          "api_key_env": "OPENAI_API_KEY",
          "timeout_seconds": 60,
          "max_attempts": 3
        },
        "gepa": {
          "max_metric_calls": 100,
          "minibatch_size": 3,
          "reflection_temperature": 1.0,
          "rng_seed": 0
        }
      }
    }
  },
  "live": {
    "max_consecutive_faults": 3
  },
  "schedule": [
    {"kind": "harness_until_publish", "label": "pre_training", "max_moves": 12},
    {"kind": "harness", "label": "pre_training"},
    {"kind": "rollback", "to": "first_publish"},
    {"kind": "harness", "label": "pre_training", "repeat": 29}
  ]
}
