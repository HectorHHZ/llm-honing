{
  "description": "pi on three real OfficeQA questions with a real model (Qwen3 Coder 30B A3B on Amazon Bedrock, through Bedrock's OpenAI-compatible endpoint: the openai_chat runtime). Needs AWS_BEARER_TOKEN_BEDROCK (a Bedrock API key; a short-term one can be made from AWS credentials with aws-bedrock-token-generator), Node.js 22.19 or newer with pi installed (integrations/pi/README.md), and the data: python -m integrations.officeqa.fetch --out integrations/officeqa/.cache --uids UID0002,UID0006,UID0016 (with HF_TOKEN). Run: python scripts/e2e/check_runner.py --config configs/e2e/pi_officeqa.json, then the same with honing_pipeline.py. Only the harness plane is real; its two scripted moves add a search skill, then the grep and find tools, each gated on the same three questions. The other planes are fakes that are never scheduled but must be named.",
  "work_dir": "runs/e2e-pi-officeqa",
  "requires": {
    "env": [
      "AWS_BEARER_TOKEN_BEDROCK"
    ],
    "commands": [
      "node"
    ],
    "paths": [
      "integrations/pi/node_modules/@earendil-works/pi-coding-agent/package.json",
      "integrations/officeqa/.cache/corpus",
      "integrations/officeqa/.cache/officeqa_full.csv",
      "integrations/officeqa/.cache/reward.py"
    ]
  },
  "tasks": {
    "factory": "integrations.officeqa.e2e:tasks",
    "args": {
      "data_dir": "{root}/integrations/officeqa/.cache",
      "uids": [
        "UID0002",
        "UID0006",
        "UID0016"
      ]
    }
  },
  "harness_seed": {
    "factory": "honing.backends.pi.e2e:seed_harness",
    "args": {
      "instructions": "You answer questions about the documents in your working directory.\nLook figures up in the documents rather than answering from memory, and report them in the unit the question asks for.\n",
      "tools": [
        "read",
        "bash"
      ]
    }
  },
  "components": {
    "model_source": {
      "factory": "honing.backends.llm_gateway:model_source",
      "args": {
        "base_url": "https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1",
        "model": "qwen.qwen3-coder-30b-a3b-v1:0",
        "api_key_env": "AWS_BEARER_TOKEN_BEDROCK",
        "input_usd_per_million": 0.15,
        "output_usd_per_million": 0.6
      }
    },
    "endpoints": {
      "factory": "honing.backends.llm_gateway:endpoints",
      "args": {
        "base_url": "https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1",
        "model": "qwen.qwen3-coder-30b-a3b-v1:0",
        "api_key_env": "AWS_BEARER_TOKEN_BEDROCK",
        "input_usd_per_million": 0.15,
        "output_usd_per_million": 0.6
      }
    },
    "trainer": {
      "factory": "tests.fakes.pipeline:trainer"
    },
    "data": {
      "factory": "tests.fakes.pipeline:data"
    },
    "rollout": {
      "factory": "tests.fakes.pipeline:rollout"
    },
    "scorer": {
      "factory": "tests.fakes.pipeline:scorer"
    },
    "selector": {
      "factory": "tests.fakes.pipeline:selector"
    },
    "editor": {
      "factory": "tests.fakes.pipeline:editor"
    },
    "quantizer": {
      "factory": "tests.fakes.pipeline:quantizer"
    },
    "telemetry": {
      "factory": "tests.fakes.pipeline:telemetry"
    },
    "runner": {
      "factory": "honing.backends.pi.e2e:runner",
      "args": {
        "tools": [
          "read",
          "bash",
          "edit",
          "write",
          "grep",
          "find",
          "ls"
        ],
        "default_tools": [
          "read",
          "bash"
        ],
        "mounts": {
          "corpus": "{root}/integrations/officeqa/.cache/corpus"
        },
        "concurrency": 2,
        "timeout_seconds": 600
      }
    },
    "grader": {
      "factory": "integrations.officeqa.e2e:grader",
      "args": {
        "data_dir": "{root}/integrations/officeqa/.cache",
        "uids": [
          "UID0002",
          "UID0006",
          "UID0016"
        ]
      }
    },
    "method": {
      "factory": "integrations.officeqa.scripted:method",
      "args": {
        "edits": [
          {
            "path": "skills/treasury-bulletins/SKILL.md",
            "kind": "skill",
            "note": "add a skill for searching Treasury Bulletins",
            "file": "{root}/integrations/officeqa/skills/treasury-bulletins/SKILL.md"
          },
          {
            "path": "pi/settings.json",
            "kind": "settings",
            "json": {
              "defaultTools": [
                "read",
                "bash",
                "grep",
                "find"
              ]
            },
            "note": "give the agent the grep and find tools"
          }
        ]
      }
    }
  },
  "conformance": {
    "probe": {
      "factory": "honing.backends.pi.e2e:probe"
    },
    "concurrent": 2
  },
  "selectors": {
    "default": {
      "win_loss": {}
    }
  },
  "schedule": [
    {
      "kind": "harness",
      "label": "add-search-skill"
    },
    {
      "kind": "harness",
      "label": "add-search-tools"
    }
  ]
}
