# Source this file from bash after replacing the paths.
export RA2_GAME_DIR=/absolute/path/to/red-alert-2
# Directory containing dist/index.js and the SDK's bundled engine binary.
export RA2_SDK_DIR=/absolute/path/to/ra2-game-env-0.1.0/js/package
export SUPALOSA_DIR=/absolute/path/to/supalosa-chronodivide-bot
export LAYA_SOURCE_DIR=/absolute/path/to/laya
export LAYA_PYTHON=/absolute/path/to/model-venv/bin/python
# Optional; defaults to integrations/ra2/.cache/models.
# export LAYA_MODEL_CONFIG_DIR=/absolute/path/to/model-configs
# Kev (optional): the environment and source scripts/setup-kev.sh prepares.
# export KEV_PYTHON=/absolute/path/to/kev-env/bin/python
# export KEV_SOURCE_DIR=/absolute/path/to/integrations/ra2/deps/kev
# NanoJev (optional): the environment and source scripts/setup-nanojev.sh prepares.
# export NANOJEV_PYTHON=/absolute/path/to/nanojev-env/bin/python
# export NANOJEV_SOURCE_DIR=/absolute/path/to/integrations/ra2/deps/nanojev
# StartLux-Decision (optional): the environment and source scripts/setup-startlux.sh prepares.
# export STARTLUX_PYTHON=/absolute/path/to/startlux-env/bin/python
# export STARTLUX_SOURCE_DIR=/absolute/path/to/integrations/ra2/deps/startlux
