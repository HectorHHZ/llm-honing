# Optional shell configuration. Copy to a local .env, review it, then opt in:
# RA2_ENV_FILE="$PWD/.env" bash run.sh --check
# This is shell code; load only a configuration file you trust.
# No .env file is loaded automatically. Existing environment variables are
# respected by defaults; assignments in an explicit file override them.

RA2_LAB_DIR="${HOME}/ra2-lab"

# Optional. The launcher otherwise selects portable Node v22.23.4 from the lab
# on Linux x86_64, then Node from PATH. Node.js 22 or newer is required.
# RA2_NODE_BIN="/usr/bin/node"

LAYA_RELEASE_DIR="${RA2_LAB_DIR}/laya-ra2-v33-51d2f5a"
# Must resolve to the same directory as LAYA_RELEASE_DIR for this experiment.
LAYA_MODEL_PATH="${LAYA_RELEASE_DIR}"
LAYA_SOURCE_DIR="${RA2_LAB_DIR}/laya-970dc8c"
LAYA_VENV_DIR="${RA2_LAB_DIR}/laya-v33-cpu-venv"
LAYA_PYTHON="${LAYA_VENV_DIR}/bin/python"
SUPALOSA_DIR="${RA2_LAB_DIR}/supalosa-165b77a"
RA2_GAME_DIR="${RA2_LAB_DIR}/game-assets-headless-v1"

# The default SDK path is resolved relative to run.sh, regardless of cwd:
# integrations/ra2/engine/ra2-game-env-0.1.1/js/package
# RA2_SDK_DIR="/absolute/path/to/ra2-game-env-0.1.1/js/package"
# RA2_ENGINE_BIN="/absolute/path/to/ra2-engine"

# Setup only: the Python used to create the isolated environment (Python 3.12).
# LAYA_BOOTSTRAP_PYTHON="/usr/bin/python3"

# Optional CPU worker timeouts, in milliseconds.
# LAYA_STARTUP_TIMEOUT_MS=600000
# LAYA_REQUEST_TIMEOUT_MS=600000
