{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSONL client requests (IPC IDs are assigned by the client)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "state"
        }
      },
      "required": [
        "op"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "reset"
        },
        "seed": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "required": [
        "op"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "step"
        },
        "action": {
          "$ref": "action.schema.json"
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        }
      },
      "required": [
        "op",
        "action"
      ]
    }
  ]
}
