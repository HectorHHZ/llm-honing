--- a/src/platform/web-platform.c
+++ b/src/platform/web-platform.c
@@ -1,4 +1,4 @@
-#define _POSIX_C_SOURCE 199309L
+#define _POSIX_C_SOURCE 200809L

 #include <stdio.h>
 #include <string.h>
@@ -116,13 +116,30 @@ static void flushOutputBuffer() {
     char msg[80];
     int no_bytes_sent;

-    no_bytes_sent = sendto(wfd, outputBuffer, outputBufferPos, 0, (struct sockaddr *)&addr_write, sizeof(struct sockaddr_un));
+    if (!outputBufferPos) {
+        return;
+    }
+
+    // Darwin reports ENOBUFS if the local reader has not drained its queue yet.
+    // A dropped datagram would leave the incremental display out of sync.
+    do {
+        no_bytes_sent = sendto(wfd, outputBuffer, outputBufferPos, 0, (struct sockaddr *)&addr_write, sizeof(struct sockaddr_un));
+        if (no_bytes_sent == -1 && errno == ENOBUFS) {
+            const struct timespec backoff = {0, 1000000};
+            nanosleep(&backoff, NULL);
+            errno = ENOBUFS;
+        }
+    } while (no_bytes_sent == -1 && (errno == ENOBUFS || errno == EINTR));
     if (no_bytes_sent == -1) {
         snprintf(msg, 80, "Error: %s\n", strerror(errno));
         writeToLog(msg);
+        fprintf(stderr, "%s", msg);
+        exit(EXIT_FAILURE);
     } else if (no_bytes_sent != outputBufferPos) {
         snprintf(msg, 80, "Sent %d bytes only - %s\n", no_bytes_sent, strerror(errno));
         writeToLog(msg);
+        fprintf(stderr, "%s", msg);
+        exit(EXIT_FAILURE);
     }

     outputBufferPos = 0;
@@ -157,8 +174,7 @@ static void web_plotChar(enum displayGlyph inputChar,
     unsigned char firstCharByte, secondCharByte;
     enum displayGlyph translatedChar;

-    translatedChar = glyphToUnicode(inputChar);
