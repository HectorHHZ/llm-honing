# Optional. Without a model, both editions offer local two-player matches.
# Use the base URL of honing.backends.jev.server, not /v1/decide itself.
# HONING_URL=http://127.0.0.1:8080
# MODEL_LABEL=My decision model
# HONING_TOKEN=server-side-bearer-token
PORT=4177
HOST=127.0.0.1
# For an HTTPS reverse proxy, set its exact external origin.
# PUBLIC_ORIGIN=https://games.example.com
# Optional default route: classic or auto-aim. Unset to show the edition selector.
# DEFAULT_EDITION=classic

# Compatibility with existing tank-specific /health and /decision servers:
# CLASSIC_MODEL_URL=http://127.0.0.1:8081
# CLASSIC_MODEL_LABEL=Classic model
# CLASSIC_NANOJEV_URL=http://127.0.0.1:8082
# AUTOAIM_MODEL_URL=http://127.0.0.1:8083
# AUTOAIM_MODEL_LABEL=Auto Aim model

# Additional endpoints / checkpoint variants. IDs must be unique per edition.
# Each entry uses transport "honing" (/v1/health + /v1/decide) or "tank" (/health + /decision).
# Labels identify a configured endpoint; the actual checkpoint is loaded by that model service.
# MODELS_JSON='[{"id":"nano-v1","label":"NanoJev","version":"checkpoint-1","url":"http://127.0.0.1:8084","transport":"honing","editions":["classic"]}]'
