{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_index", "cause", "impact_on_loss", "confidence", "explanation"],
  "properties": {
    "decision_index": {"type": ["integer", "null"], "minimum": 0},
    "cause": {"type": "string", "enum": ["harness", "weights", "controller", "uncertain"]},
    "impact_on_loss": {"type": "string", "enum": ["likely", "unclear", "unlikely"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "explanation": {"type": "string", "maxLength": 1200}
  }
}
